<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_glanceable_dial_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dial"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: App Name and Active Streak Flame -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="@string/widget_app_title"
            android:textColor="#8B92A4"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_active_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="🔥 0d"
            android:textColor="#FFB800"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Center: Today's Focus Minutes Counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_today_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:text="0m"
            android:textColor="#F4F6FB"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:text="@string/widget_todays_focus"
            android:textColor="#8B92A4"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Action Button: Lock In -->
    <TextView
        android:id="@+id/widget_button_lockin"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/widget_button_lockin"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:text="@string/widget_btn_lockin"
        android:textColor="#090A0D"
        android:textSize="12sp" />
</LinearLayout>
